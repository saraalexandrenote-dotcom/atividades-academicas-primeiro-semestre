Algoritmo "horas-minutos-segundos"
//  
//  
// 
//  
// Descrição   : Ler um número de horas e exibir o equivalente em minutos e em segundos.
// Autor(a)    :Sara Alexandre
// Data atual  : 29/10/2026
Var

 horas,minutos,segundos:inteiro

Inicio

 escreva("Digite a quantidade de horas:")
 leia(horas)
 minutos<-horas*60
 segundos<-horas*3600
 escreval("Equivalente em minutos:",minutos," minutos")
 escreval("Equivalente em segundos:",segundos," segundos")

Fimalgoritmo