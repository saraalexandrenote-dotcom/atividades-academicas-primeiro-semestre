Algoritmo "calculo_desconto_compra"
//  
//  
// 
//  
// Descrição   : Informar o valor que o cliente terá em sua compra com 10% de desconto
// Autor(a)    : Sara Alexandre
// Data atual  : 23/10/2026
 Var
 compra,desconto:real

Inicio

    escreva("Digite o valor da compra:")
    leia(compra)
    desconto <-compra*10/100
    desconto<-compra-desconto
    escreval("Com desconto de 10% o valor fica:",desconto)
    
Fimalgoritmo