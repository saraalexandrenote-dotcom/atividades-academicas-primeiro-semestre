Algoritmo "calculo"
//  
//  
// 
//  
// Descrição   : Ler dois números e exibir a soma, a diferença, o produto e o quociente.
// Autor(a)    : Sara Alexandre
// Data atual  : 29/10/2026
Var

 numero,numero2,soma,diferenca,produto,quociente:real


Inicio

 escreva("Digite o primeiro número:")
 leia(numero)
 escreval()
 escreva("Digite o segundo número:")
 leia(numero2)
 soma<-numero+numero2
 escreval()
 escreval("O resultado da soma é:",soma)
 diferenca<-numero-numero2
 escreval("O resultado da subtração é:",diferenca)
 produto<-numero*numero2
 escreval("O resultado da multiplicação é:",produto)
 quociente<-numero/numero2
 escreval("O resultado da divisão é:",quociente)

Fimalgoritmo